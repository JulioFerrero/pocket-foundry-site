---
/** Every page: one numbered sheet of the drawing, in the game window. */
import Seo from '../components/Seo.astro';
import ResourceBar from '../components/ResourceBar.astro';
import SheetNav from '../components/SheetNav.astro';
import TitleBlock from '../components/TitleBlock.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n';
import type { SheetId } from '../sheets';
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import chakra from '../assets/fonts/chakra-petch-700.woff2?url';
import barlow from '../assets/fonts/barlow-400.woff2?url';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  sheet: SheetId | null;
  structured?: Record<string, unknown>[];
}
const { title, description, sheet, structured } = Astro.props;
const { t, locale } = useTranslations(Astro.currentLocale);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b2a4a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" as="font" type="font/woff2" href={chakra} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={barlow} crossorigin />
    <Seo title={title} description={description} structured={structured} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#content">{t('a11y.skip')}</a>
    <div class="window">
      <header class="top">
        <a class="brand" href="/">
          <Image src={icon} alt="" width={32} height={32} densities={[1, 2, 3]} loading="eager" />
          {t('site.name')}
        </a>
        <ResourceBar />
      </header>
      <main id="content" class="sheet" tabindex="-1">
        <div class="drawing">
          <slot />
          {sheet && <TitleBlock sheet={sheet} />}
        </div>
      </main>
      <aside class="corner">
        <SheetNav current={sheet} />
      </aside>
      <Footer />
    </div>
    <script is:inline>
      // In the window layout the sheet is what scrolls: give it the keyboard, so the arrow keys move it from the start.
      if (!location.hash) document.getElementById('content').focus({ preventScroll: true });
    </script>
  </body>
</html>
